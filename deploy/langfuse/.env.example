# ---------------------------------------------------------------------------
# 自托管 Langfuse 部署配置模板
# ---------------------------------------------------------------------------
# 复制本文件到同目录的 `.env`（`cp .env.example .env`）并填入真实值。
# 真实 `.env` 不入库：仓库根 `.gitignore` 的 `.env` 规则匹配任意层级。
#
# 取值要点
# --------
# 1. 值一律**不加引号**。Langfuse 官方明确说明：在 compose 里给 LANGFUSE_INIT_*
#    的值加双引号会导致初始化失败。
# 2. ENCRYPTION_KEY 必须是 64 位十六进制（32 字节），生成方式：
#       openssl rand -hex 32
# 3. 口令只用 A-Za-z0-9 与 - _ 三种符号。因为 POSTGRES_PASSWORD 会被拼进
#    DATABASE_URL 的 userinfo 段，出现 @ : / 等字符会把连接串解析错。
# 4. 本项目已用脚本把下面全部密钥一次性生成好并写入 `.env`；本模板仅供
#    换机器时重建使用。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 镜像源
# ---------------------------------------------------------------------------
# 官方模板用 docker.langfuse.com，该域名最终仍回 Docker Hub 取镜像，国内网络
# 不通。留空则直接用 docker.io（需能直连 Docker Hub）。
DOCKER_MIRROR=docker.1panel.live/

# ---------------------------------------------------------------------------
# 基础设施口令（四个都要换成长随机值）
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=

# MinIO 的桶名固定为 langfuse，由 compose 里的启动命令创建，不需要配置
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 应用密钥（必须换，且三个互不相同）
# ---------------------------------------------------------------------------

# 会话签名密钥
NEXTAUTH_SECRET=

# 密钥哈希盐值
SALT=

# 用于加密存储的敏感字段（如接入的模型 API Key）。64 位十六进制。
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 免注册初始化（首次启动时自动建组织 / 项目 / 用户）
# ---------------------------------------------------------------------------
# 仅在实例还没有任何组织时执行一次。四个「必填」项缺一，初始化会被跳过。
# 这里指定的 PUBLIC_KEY / SECRET_KEY 就是后续 SDK 直接使用的密钥，不需要登录
# 界面去拷贝——它们只在这里定义一次，因此是可复现的固定值。

LANGFUSE_INIT_ORG_ID=local
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=agent-service
LANGFUSE_INIT_PROJECT_NAME=Agent Service

# 形如 pk-lf-xxxx / sk-lf-xxxx
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=

# 首次登录 http://localhost:3000 用这个账号
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=
