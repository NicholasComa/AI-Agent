<mxfile host="app.diagrams.net" modified="2026-08-19" agent="workbuddy" version="24.0" type="device">
  <diagram id="week05-rag-flow" name="RAG检索流程图">
    <mxGraphModel dx="800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 阶段一分组 -->
        <mxCell id="g1" value="阶段一：建库（离线，运行一次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#888888;verticalAlign=top;align=left;fontStyle=1;fontColor=#444444;fontSize=13;spacingLeft=16;top=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="620" height="508" as="geometry" />
        </mxCell>

        <!-- 阶段二分组 -->
        <mxCell id="g2" value="阶段二：检索（在线，每次查询）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#888888;verticalAlign=top;align=left;fontStyle=1;fontColor=#444444;fontSize=13;spacingLeft=16;top=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="584" width="620" height="448" as="geometry" />
        </mxCell>

        <!-- 阶段一节点 -->
        <mxCell id="a1" value="原始文档&lt;br&gt;&lt;font size=2&gt;.md / .txt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="96" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="文档解析&lt;br&gt;&lt;font size=2&gt;load_documents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="172" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="文本切分&lt;br&gt;&lt;font size=2&gt;chunk_text · Chunk + Overlap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="248" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="逐片段 Embedding&lt;br&gt;&lt;font size=2&gt;（同一 Embedder）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="324" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="构造 Point&lt;br&gt;&lt;font size=2&gt;向量 + Payload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="写入 Qdrant 向量库&lt;br&gt;&lt;font size=2&gt;upsert · rag_chunks · Cosine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="476" width="540" height="50" as="geometry" />
        </mxCell>

        <!-- 阶段二节点 -->
        <mxCell id="b1" value="用户查询&lt;br&gt;&lt;font size=2&gt;query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="624" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="查询 Embedding&lt;br&gt;&lt;font size=2&gt;（同一 Embedder）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="700" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="向量检索&lt;br&gt;&lt;font size=2&gt;取 TopK · 可选 source 过滤&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="776" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="返回 RetrievalResult&lt;br&gt;&lt;font size=2&gt;chunk_id / source / score / text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="852" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="结束：全程不调用 LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="928" width="540" height="50" as="geometry" />
        </mxCell>

        <!-- 生成职责（独立） -->
        <mxCell id="gen" value="生成回答 Generation&lt;br&gt;&lt;font size=2&gt;（独立职责，本周未实现，不进主链路）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="1004" width="540" height="48" as="geometry" />
        </mxCell>

        <!-- 主链路实线箭头（加粗 strokeWidth=2.5） -->
        <mxCell id="e1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2.5;endArrow=block;startArrow=none;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 后续（不在主链路） -->
        <mxCell id="e10" value="后续（不在主链路）" style="edgeStyle=none;rounded=0;html=1;dashed=1;strokeWidth=2.5;strokeColor=#B85450;endArrow=block;startArrow=none;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b5" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 共用 Embedder：a4 右侧 ↔ b2 右侧（无方向，仅表同一） -->
        <mxCell id="d1" value="同一 Embedder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeWidth=2.5;strokeColor=#B85450;endArrow=none;startArrow=none;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="b2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="349"/>
              <mxPoint x="700" y="725"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 共用 向量库：a6 左侧 ↔ b3 左侧（无方向，仅表同一） -->
        <mxCell id="d2" value="同一 向量库" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeWidth=2.5;strokeColor=#B85450;endArrow=none;startArrow=none;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="b3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="501"/>
