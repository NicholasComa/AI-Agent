# Copy this file to `.env` and fill in real values.
# Real `.env` MUST stay out of version control (see `.gitignore`).

# ---------------------------------------------------------------------------
# Model API (filled in from Day 3 onward)
# ---------------------------------------------------------------------------
# Required. API key for the team-provided model gateway.
API_KEY=

# Required. OpenAI-compatible base URL.
API_BASE_URL=https://api.example.com/v1

# Required. Model identifier to call by default.
MODEL_NAME=

# Optional. Request timeout in seconds.
TIMEOUT_SECONDS=30

# Optional. Enable streaming responses (true / false).
ENABLE_STREAM=false
