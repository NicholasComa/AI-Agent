# ---------------------------------------------------------------------------
# llm-gateway-demo · Day 6 配置模板
# ---------------------------------------------------------------------------
# 复制本文件到 `.env` 并填写真实值；真实 `.env` 不入库（见 .gitignore）。
#
# 字段加载优先级：进程 env vars > .env 文件 > 字段默认值。
# 切换模型：只改 MODEL_NAME 与 API_BASE_URL，无需改业务代码（路线「通过标准」）。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 身份 / 必填
# ---------------------------------------------------------------------------

# 应用名（用于日志/响应标识）。默认 llm-gateway-demo。
APP_NAME=llm-gateway-demo

# 必填。团队模型接口 API Key。**绝不写入日志或异常消息**。
API_KEY=ollama

# 必填。OpenAI 兼容 base URL。
# 示例：OpenAI: https://api.openai.com/v1
#      DeepSeek: https://api.deepseek.com/v1
#      Ollama:   http://localhost:11434/v1
API_BASE_URL=https://api.example.com/v1

# 必填。默认模型标识。切换模型只改本字段。
MODEL_NAME=

# ---------------------------------------------------------------------------
# 调用控制
# ---------------------------------------------------------------------------

# 单次请求超时（秒）。
TIMEOUT_SECONDS=30

# 是否开启流式输出（true / false）。Week 02 默认开启。
ENABLE_STREAM=true

# 临时性失败时的最大额外重试次数（0 表示不重试）。
MAX_RETRIES=2

# 指数退避基准秒数；实际延迟 = RETRY_BACKOFF * 2 ** attempt。
RETRY_BACKOFF=0.5

# 同时打到上游的请求上限（Semaphore）。超出排队等待。
MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Provider / 日志 / /models 兜底
# ---------------------------------------------------------------------------

# 模型客户端实现。当前支持："openai_compatible"（默认）、"ollama"。
PROVIDER=openai_compatible

# 日志级别：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO

# 日志格式："json"（机器可读，默认）或 "plain"（人类可读）。
LOG_FORMAT=json

# /models 端点上游不可用时的兜底模型列表（逗号分隔）。
# 示例：gpt-4o-mini,deepseek-chat,qwen-turbo
EXTRA_MODELS=

# ---------------------------------------------------------------------------
# Week 4 · Dify Cloud（工作流 API 调用）
# ---------------------------------------------------------------------------
# DIFY_API_KEY 是「工作流级」密钥，不是 Dify 账号级密钥。每个应用独立。
# 获取路径：Dify Studio → 打开应用 → 发布 → API 访问 → 复制密钥。
# 用途：scripts/call_dify_workflow.py（Day 16 验证）、src/dify_client.py（Day 18+）
DIFY_API_KEY=

# Dify API base URL。Dify Cloud 默认如下；本地自托管时改为 http://localhost/v1。
# 本阶段实际使用本地 Dify：DIFY_BASE_URL=http://localhost/v1
DIFY_BASE_URL=https://api.dify.ai/v1

# ---------------------------------------------------------------------------
# Week 5 · Embedding 接口（Ollama / OpenAI 兼容）
# ---------------------------------------------------------------------------
# 当 EMBEDDING_API_BASE_URL 与 EMBEDDING_MODEL_NAME 同时非空时，rag.get_embedding()
# 走真实 EmbeddingClient；否则回退到离线 FakeEmbedding（仅供单元测试用）。
# Ollama 默认 11434 端口提供 /v1/embeddings 作为 OpenAI 兼容端点，Ollama 无 key。
EMBEDDING_API_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=mxbai-embed-large
EMBEDDING_API_KEY=
EMBEDDING_MAX_RETRIES=2
EMBEDDING_BACKOFF_SECONDS=0.5

# ---------------------------------------------------------------------------
# Week 5 · Qdrant 向量库
# ---------------------------------------------------------------------------
# 运行模式：local（进程内嵌，无需服务） / docker（连接远程 Qdrant）。
# QDRANT_VECTOR_SIZE 必须与 EMBEDDING_MODEL_NAME 的输出维度一致（mxbai-embed-large = 1024）。
QDRANT_MODE=docker
QDRANT_PATH=:memory:
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_chunks
QDRANT_VECTOR_SIZE=1024

# ---------------------------------------------------------------------------
# Week 10 · 可观测性（Langfuse 追踪）
# ---------------------------------------------------------------------------
# 服务由 deploy/langfuse/compose.yaml 提供，启动方式见该目录 README.md。
#
# 后端选择：local（记录只落 JSONL） / langfuse（上报到 Langfuse 实例）。
# 选 langfuse 但 SDK 缺失或密钥不齐时，追踪层自动降级为 local，服务照常启动。
# 注意：两个后端是互斥的——选 langfuse 时不再写本地 JSONL。若 Langfuse 实例
# 没起来，记录将只存在于远端 SDK 的失败重试里，因此跑评测前先确认栈在运行。
OBS_ENABLED=true
OBS_BACKEND=langfuse
OBS_TRACE_DIR=logs/traces
OBS_SAMPLE_RATE=1.0

# 是否记录提示词与回答正文。默认 false。
# 「只上传元数据」在这里是结构性的而非约定性的：capture_content 为假时
# 记录体的 content 字段恒为 None，上报层也从不传 input/output 字段。
OBS_CAPTURE_CONTENT=false
OBS_MAX_CONTENT_CHARS=2000
OBS_MAX_LABEL_CHARS=64

# 自托管实例地址。deploy/langfuse/compose.yaml 起的栈监听宿主机 3000 端口。
# 在容器内运行服务时（仓库根 compose.yaml 的 api 服务）会被覆盖为
# http://host.docker.internal:3000，因为容器里的 localhost 是容器自身。
LANGFUSE_BASE_URL=http://localhost:3000

# 密钥由 deploy/langfuse/.env 的 LANGFUSE_INIT_* 在实例首次启动时写入，
# 之后可在 UI 的 Settings → API Keys 复查。真实密钥不入库。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 可选的发布标识，会写进 trace 的版本字段，便于区分不同轮次的评测。
LANGFUSE_RELEASE=

# 第二道正文防线：关掉 SDK 的 @observe 装饰器对输入输出的自动捕获。
# 本项目只用上下文管理器、不传 input/output，这一项是防御性的显式关闭；
# 若将来有人加了 @observe 装饰器，它保证正文仍然不会被自动带出去。
LANGFUSE_OBSERVE_DECORATOR_IO_CAPTURE_ENABLED=false